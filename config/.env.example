# config/.env — OPTIONAL per-project credentials (gitignored)
#
# Copy this file to config/.env and fill in the values you want to override.
# Everything is already wrapped in env_or()/env_list_or(), so you can use a
# .env file only for the values that differ on THIS machine and leave the
# rest blank — whatever is missing falls through to config/secrets.php with
# the same precedence for every value. Nothing here is required to run; it is
# the environment substitute for hosts that cannot set real variables.
#
# Precedence: real environment > config/.env > config/secrets.php > default.
#   - A value already set in the real environment is never overridden.
#   - An empty value here behaves like "not set" (falls through to secrets.php).
#   - config/.htaccess denies HTTP for this whole directory.
#
# Syntax: KEY=value, one per line. Blank lines and lines starting with '#'
# are ignored. Values may be wrapped in double or single quotes.
#
# Canonical URL / environment. APP_URL fixes the host used for password-reset
# links, Paystack callbacks and canonical tags, so it cannot be supplied by a
# request Host header. It must be https for any public host; http is accepted
# only for localhost/loopback/.test. Leave APP_URL blank locally to fall back
# to a fixed http://localhost<subdir>/ (still not the request Host).
#   Local:      APP_ENV=local        APP_URL=http://localhost/handel-luxe-php
#   Staging:    APP_ENV=staging      APP_URL=https://staging.example.com
#   Production: APP_ENV=production   APP_URL=https://example.com
APP_ENV=local
APP_URL=

# The single most important entry for the live site:
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Gmail SMTP (App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO_ADMIN=

# Database (XAMPP defaults shown; empty DB_PASS means MySQL has no password)
DB_HOST=127.0.0.1
DB_PORT=1471
DB_USER=root
DB_PASS=
DB_NAME=handel_luxe_db

# Scheduled backups: absolute private path outside the website document root.
# Example for cPanel: /home/ACCOUNT/private/handel-luxe-backups
BACKUP_DIR=

# Independent /developer dashboard login (never a store user account).
# Configure a username and a password_hash() value in config/.env or secrets.php.
DEVELOPER_DASH_USERNAME=
DEVELOPER_DASH_PASSWORD_HASH=

# WhatsApp order alerts (comma-separated, international format, no '+')
WHATSAPP_ADMIN_NUMBERS=
TWILIO_WHATSAPP_SID=
TWILIO_WHATSAPP_TOKEN=
TWILIO_WHATSAPP_FROM=
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_ID=

# Installer key (see setup.php; leave empty to disable the installer)
SETUP_KEY=